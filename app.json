{
  "expo": {
    "name": "MeloneLite",
    "slug": "MeloneLite",
    "version": "2.2.2",
    "orientation": "default",
    "icon": "./assets/appnew.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/appnew.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.melonelite.restaurant",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
       
      "adaptiveIcon": {
        "foregroundImage": "./assets/appnew.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.melonelite.restaurant",
      "usesCleartextTraffic": true,
      "versionCode": 5,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/json" },
            { "scheme": "file", "mimeType": "application/json" },
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "file", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/x-sqlite3" },
            { "scheme": "content", "mimeType": "application/vnd.sqlite3" },
            { "scheme": "content", "mimeType": "application/sql" },
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\\\.db" },
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\\\.json" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "melonelite",
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MeloneLite to access your photos for item images.",
          "cameraPermission": "Allow MeloneLite to use camera to capture item images."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "408ff29d-f569-47b2-944d-6db12d29f2b1"
      }
    }
  }
}
